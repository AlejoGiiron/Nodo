# ============================================================
# G-Nexo — STAGING · plantilla de entorno
#
# ⛔ Copiar a `docs/staging/.env.staging` y completar. ESE archivo NO se
#    commitea (está en .gitignore). Éste es la plantilla y va vacío.
#
# 🔴 NINGÚN SECRETO SE REUTILIZA DE G-VENTO. Ni uno.
#    El que más importa es JWT_SECRET: si staging y producción comparten el
#    mismo, un token emitido en staging ES VÁLIDO EN PRODUCCIÓN. No es
#    "higiene", es una puerta abierta — y silenciosa, porque todo funciona.
# ============================================================

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
POSTGRES_PORT=5533
POSTGRES_DB=postgres

# ── JWT y claves derivadas ──────────────────────────────────────────────────
# JWT_SECRET: 40+ caracteres aleatorios.  openssl rand -base64 48
# ANON_KEY y SERVICE_ROLE_KEY se DERIVAN de ese secreto: no se inventan a mano
# ni se copian de otro stack. Se generan con el generador de la doc de Supabase
# self-hosted usando ESTE JWT_SECRET.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Puertos (deben coincidir con docker-compose.staging.yml) ────────────────
KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8543
STUDIO_PORT=3100

# ── URLs ────────────────────────────────────────────────────────────────────
# Sin dominio propio, se accede por IP:puerto. Si se le pone dominio, tiene que
# ser DISTINTO del de G-Vento y con su propio certificado.
API_EXTERNAL_URL=http://<host>:8100
SUPABASE_PUBLIC_URL=http://<host>:8100
SITE_URL=http://<host>:3100

# ── Studio ──────────────────────────────────────────────────────────────────
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ── Correo ──────────────────────────────────────────────────────────────────
# 🔴 STAGING NO MANDA MAIL A DIRECCIONES REALES. Un stack de pruebas con SMTP
#    de producción manda invitaciones y recuperaciones de contraseña a clientes
#    de verdad. Si no hay un SMTP de prueba, se deja vacío y se leen los links
#    desde los logs.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
ENABLE_EMAIL_AUTOCONFIRM=true
