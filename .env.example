# Nodo — variables de entorno
# Copiar a .env.local y completar. NUNCA commitear .env.local

VITE_NODO_SUPABASE_URL=
VITE_NODO_SUPABASE_ANON_KEY=

# ── Sentry ──────────────────────────────────────────────────────────────────
# 🔴 SIN prefijo de producto, a propósito: estos son los nombres que LEE
# src/lib/sentry.ts. Este archivo se alineó al código y no al revés (2026-08-31)
# porque el código es el que ejecuta — si algo lo contradice, gana el código.
#
# Antes acá decía `VITE_NODO_SENTRY_DSN`, que el código nunca leyó: Sentry no
# inicializaba y no había ningún síntoma, solo ausencia de reportes. Ver
# docs/BITACORA.md y la deuda #29.9.
#
# Sentry se activa SOLO en build de producción, con DSN presente y navegador no
# automatizado. En `pnpm dev` y en los E2E no se enciende nunca.
VITE_SENTRY_DSN=

# Opcionales. Sin ellas, environment cae en 'production' y release queda vacío.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
